rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar: verificar que el usuario solo accede a sus datos
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Regla principal: cada usuario solo ve sus propios datos
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Perfil del usuario
      match /profile {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Configuración
      match /settings {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Instituciones
      match /institutions/{institutionId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        // Info de la institución
        match /info {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
        
        // Horario
        match /schedule {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
        
        // Materias
        match /subjects/{subjectId} {
          allow read, write: if isAuthenticated() && isOwner(userId);
          
          // Subcolecciones de cada materia
          match /{document=**} {
            allow read, write: if isAuthenticated() && isOwner(userId);
          }
        }
        
        // Eventos, logs, contactos familiares
        match /{collectionId} {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
      }
    }
    
    // Bloquear todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
