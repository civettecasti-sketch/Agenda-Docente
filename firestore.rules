rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar: verificar que el usuario solo accede a sus datos
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Regla principal: cada usuario solo ve sus propios datos
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Perfil del usuario
      match /profile/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Configuración
      match /settings/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Instituciones
      match /institutions/{institutionId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        // Subcolecciones de instituciones (materias, etc.)
        match /{document=**} {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
      }
      
      // Materias (si se guardan como colección independiente)
      match /subjects/{subjectId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        match /{document=**} {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
      }
      
      // Alumnos
      match /students/{studentId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        match /{document=**} {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
      }
      
      // Eventos
      match /events/{eventId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Bitácoras/Logs
      match /logs/{logId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Contactos familiares
      match /familyContacts/{contactId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
      
      // Cualquier otra subcolección del usuario
      match /{collectionId}/{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Bloquear todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
